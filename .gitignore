*.bak4-*

# FreeIPA — the directory's own state and its secrets. /data holds the CA
# private key; .env holds the admin and LDAP bind passwords.
freeipa/data/
freeipa/.env

# OpenBao broker token, minted by provision-bao-broker.sh. The whole point of
# the broker is that the fleet's secrets stop living in this repo — a committed
# token would put the key to all of them right back in it.
secrets/
*.bak-prequarantine-*
