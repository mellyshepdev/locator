# Copy to freeipa/.env and chmod 600. Git-ignored — never commit the real one.

# FreeIPA Directory Manager (LDAP superuser) — used only at install time.
IPA_DM_PASSWORD=bao://secret/compose/units/unit4/freeipa-env.example#IPA_DM_PASSWORD

# FreeIPA "admin" principal — used by bootstrap-ipa.sh.
IPA_ADMIN_PASSWORD=bao://secret/compose/units/unit4/freeipa-env.example#IPA_ADMIN_PASSWORD

# Read-only service account Keycloak binds as. bootstrap-ipa.sh creates the
# user with this password; keycloak-federation.sh hands the same value to
# Keycloak. They must match.
KEYCLOAK_BIND_PASSWORD=bao://secret/compose/units/unit4/freeipa-env.example#KEYCLOAK_BIND_PASSWORD

# Static IP of the FreeIPA host. Must match the A record for IPA_SERVER_HOSTNAME.
IPA_SERVER_IP=10.0.0.x

# Tenant groups to create on bootstrap (space-separated, no "tenant-" prefix).
IPA_TENANTS="acme globex"

# ── Keycloak admin, for keycloak-federation.sh ──────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=bao://secret/compose/units/unit4/freeipa-env.example#KC_ADMIN_PASSWORD
