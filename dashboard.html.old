<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>S.H.E.E.P. Unified Registry</title>
    <!-- Include vis-network for graph rendering -->
    <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
    <style>
        :root {
            /* Shared */
            --bg: #000510;
            --primary: #4169E1;
            --accent: #00f0ff;
            --danger: #ff003c;
            --success: #00ff00;
            /* Grid Specific */
            --grid-bg: #050505;
            --neon-green: #00ff00;
            --neon-green-dim: rgba(0, 255, 0, 0.2);
            --neon-blue: #00f0ff;
        }

        body {
            background-color: var(--bg);
            color: #fff;
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
            background-image: radial-gradient(circle at center, #001030 0%, #000510 100%);
        }

        /* ── TOGGLE SWITCH ── */
        #ui-toggle {
            position: absolute;
            top: 20px;
            right: 30px;
            z-index: 100;
            display: flex;
            background: rgba(0, 0, 0, 0.8);
            border: 1px solid var(--accent);
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
        }
        .toggle-btn {
            background: transparent;
            color: var(--accent);
            border: none;
            padding: 10px 20px;
            font-family: inherit;
            font-size: 14px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s;
        }
        .toggle-btn.active {
            background: var(--accent);
            color: #000;
            font-weight: bold;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
        }

        /* add docker container button */
#add-docker-btn {
    z-index: 9999 !important;
    background-color: #007bff;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.3);
}

#add-docker-btn:hover {
    background-color: #0056b3;
}



        /* ── VIEW CONTAINERS ── */
        .view-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
        }
        .view-container.active {
            display: block;
        }

        /* ── MESH MAP STYLES ── */
        h1.map-title {
            position: absolute;
            top: 20px;
            left: 30px;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 20px;
            text-shadow: 0 0 15px var(--primary);
            z-index: 10;
            pointer-events: none;
            margin: 0;
        }
        #mynetwork {
            width: 100vw;
            height: 100vh;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }
        #info-panel {
            position: absolute;
            bottom: 30px;
            right: 30px;
            width: 300px;
            background: rgba(0, 10, 30, 0.8);
            border: 1px solid var(--primary);
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 0 20px rgba(65, 105, 225, 0.3);
            backdrop-filter: blur(5px);
            z-index: 10;
            display: none;
        }
        .info-title {
            font-weight: bold;
            color: var(--accent);
            margin-bottom: 10px;
            border-bottom: 1px solid rgba(0, 240, 255, 0.3);
            padding-bottom: 5px;
        }
        .info-row { margin-bottom: 5px; font-size: 13px; }
        .info-label { color: #aaa; }
        a { color: var(--accent); text-decoration: none; }
        a:hover { text-shadow: 0 0 5px var(--accent); }

        /* ── TACTICAL GRID STYLES ── */
        #view-grid {
            background-color: var(--grid-bg);
            background-image: 
                linear-gradient(var(--neon-green-dim) 1px, transparent 1px),
                linear-gradient(90deg, var(--neon-green-dim) 1px, transparent 1px);
            background-size: 30px 30px;
            background-position: center center;
            overflow-y: auto;
            color: var(--neon-green);
        }
        .grid-container {
            width: 95%;
            max-width: none;
            margin: 80px auto 40px auto; /* Push down to avoid toggle switch */
            background: rgba(0, 0, 0, 0.8);
            border: 1px solid var(--neon-green);
            box-shadow: 0 0 20px var(--neon-green-dim);
            padding: 20px;
            backdrop-filter: blur(5px);
        }
        .grid-green { border: 1px solid #00ff00; box-shadow: 0 0 20px rgba(0, 255, 0, 0.2); color: #00ff00; }
        .grid-purple { border: 1px solid #a200ff; box-shadow: 0 0 20px rgba(162, 0, 255, 0.2); color: #a200ff; margin-top: 40px;}
        .grid-blue { border: 1px solid #00f0ff; box-shadow: 0 0 20px rgba(0, 240, 255, 0.2); color: #00f0ff; margin-top: 40px;}

        h1.grid-title {
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 5px;
            margin-top: 0;
            margin-bottom: 40px;
            border-bottom: 2px solid var(--neon-green);
            padding-bottom: 10px;
        }
        
        .grid-green h1.grid-title { color: #00ff00; border-bottom: 2px solid #00ff00; text-shadow: 0 0 10px #00ff00; }
        .grid-green th { color: #00ff00; border-bottom: 1px solid rgba(0,255,0,0.3); }
        .grid-green td { border-bottom: 1px solid rgba(0,255,0,0.1); }
        
        .grid-purple th { border-bottom: 1px solid rgba(162,0,255,0.3); }
        .grid-purple td { border-bottom: 1px solid rgba(162,0,255,0.1); }
        
        .grid-blue th { border-bottom: 1px solid rgba(0,240,255,0.3); }
        .grid-blue td { border-bottom: 1px solid rgba(0,240,255,0.1); }

        .status-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            font-size: 14px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid var(--neon-green-dim);
        }
        th {
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 2px;
            color: var(--neon-blue);
        }
        .category-row {
            background: rgba(255, 255, 255, 0.1);
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 3px;
        }
        .cat-devices { color: #00f0ff; border-left: 5px solid #00f0ff; }
        .cat-docker { color: #ff00ff; border-left: 5px solid #ff00ff; }
        .cat-websites { color: #ffff00; border-left: 5px solid #ffff00; }
        
        tr:hover { background-color: rgba(0, 255, 0, 0.1); }
        .status-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-right: 10px;
        }
        .online {
            background-color: var(--neon-green);
            box-shadow: 0 0 8px var(--neon-green);
        }
        .offline {
            background-color: var(--danger);
            box-shadow: 0 0 8px var(--danger);
            animation: pulse 1s infinite;
        }
        .node-badge {
            background: var(--neon-green-dim);
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            border: 1px solid var(--neon-green);
            color: var(--neon-green);
        }

        .meta-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ccc;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
            margin: 2px;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.3; }
            100% { opacity: 1; }
        }
    </style>
</head>
<body>

    <!-- NOTIFICATION SYSTEM -->
    <div id="notification" style="display:none; position:fixed; top:20px; left:50%; transform:translateX(-50%); background:rgba(0,255,255,0.9); color:#000; padding:15px 30px; border-radius:5px; z-index:20000; font-weight:bold; box-shadow:0 0 20px rgba(0,255,255,0.5);">
    </div>

    <!-- UI TOGGLE -->
    <div id="ui-toggle">
        <button class="toggle-btn active" onclick="switchView('map')">Mesh Map</button>
        <button class="toggle-btn" onclick="switchView('grid')">Tactical Grid</button>
        <button class="toggle-btn" onclick="switchView('3js')">3D Mesh</button>
    </div>

    <!-- Button  -->
    <div id="upload-container" style="margin-top: 20px; display: flex; justify-content: center; gap: 10px; position: fixed; bottom: 20px; right: 20px; z-index: 9999;">
      <input type="text" id="manual-path" placeholder="/home/swoopg111/projects/my-app" style="padding: 10px; width: 300px; background: #000; border: 1px solid var(--accent); color: #fff;">
      <button id="add-docker-btn" class="blue-button" type="button" style="padding: 10px 20px; cursor: pointer; background: var(--primary); color: #fff; border: none; border-radius: 4px;">
        + Deploy Path
      </button>
    </div>

    <!-- MESH MAP VIEW -->
    <div id="view-map" class="view-container active">
        <h1 class="map-title">S.H.E.E.P. Mesh Map</h1>
        <div id="mynetwork"></div>
        <div id="info-panel">
            <div class="info-title" id="info-name">Node Name</div>
            <div class="info-row"><span class="info-label">Type:</span> <span id="info-type"></span></div>
            <div class="info-row"><span class="info-label">Status:</span> <span id="info-status"></span></div>
            <div class="info-row" id="row-url"><span class="info-label">URL:</span> <a href="#" target="_blank" id="info-url"></a></div>
            <div class="info-row" id="row-lastseen"><span class="info-label">Last Seen:</span> <span id="info-lastseen"></span></div>
        </div>
    </div>

    <!-- TACTICAL GRID VIEW -->
    <div id="view-grid" class="view-container">

        <!-- BLUE RECTANGLE: DEVICES -->
        <div class="grid-container grid-blue">
            <h1 class="grid-title" style="color: #00f0ff; border-color: #00f0ff; text-shadow: 0 0 10px #00f0ff;">Devices & Nodes</h1>
            <div class="status-header">
                <div>MESH NODES ACTIVE: <span id="count-devices" style="color: #00f0ff;">0</span></div>
                <div>SYSTEM STATUS: <span class="status-dot online" style="background-color: #00f0ff; box-shadow: 0 0 8px #00f0ff;"></span> NOMINAL</div>
            </div>
            <table>
                <thead><tr><th style="color: #00f0ff;">Device</th><th style="color: #00f0ff;">IP Address</th><th style="color: #00f0ff;">Type / OS</th><th style="color: #00f0ff;">Status</th><th style="color: #00f0ff;">Metadata</th><th style="color: #00f0ff;">Last Seen</th></tr></thead>
                <tbody id="tbody-devices"></tbody>
            </table>
        </div>

        <!-- GREEN RECTANGLE: DOCKER CONTAINERS -->
        <div class="grid-container grid-green">
            <h1 class="grid-title">Docker Containers</h1>
            <div class="status-header">
                <div>ACTIVE CONTAINERS: <span id="count-docker" style="color: #00ff00;">0</span></div>
                <div>SYSTEM STATUS: <span class="status-dot online"></span> NOMINAL</div>
            </div>
            <table>
                <thead><tr><th>Service</th><th>Node / Host</th><th>Port</th><th>Internal IP</th><th>Public / Traefik</th><th>Stats (CPU/RAM/Temp/Disk)</th><th>Status</th><th>Metadata</th><th>Last Seen</th></tr></thead>
                <tbody id="tbody-docker"></tbody>
            </table>
        </div>

        <!-- PURPLE RECTANGLE: WEBSITES -->
        <div class="grid-container grid-purple">
            <h1 class="grid-title" style="color: #a200ff; border-color: #a200ff; text-shadow: 0 0 10px #a200ff;">Websites</h1>
            <div class="status-header">
                <div>ACTIVE WEBSITES: <span id="count-websites" style="color: #a200ff;">0</span></div>
                <div>SYSTEM STATUS: <span class="status-dot online" style="background-color: #a200ff; box-shadow: 0 0 8px #a200ff;"></span> NOMINAL</div>
            </div>
            <table>
                <thead><tr><th style="color: #a200ff;">Service</th><th style="color: #a200ff;">Node / Host</th><th style="color: #a200ff;">URL</th><th style="color: #a200ff;">Status</th><th style="color: #a200ff;">Metadata</th><th style="color: #a200ff;">Last Seen</th></tr></thead>
                <tbody id="tbody-websites"></tbody>
            </table>
        </div>
    </div>

    <!-- 3D MESH VIEW -->
    <div id="view-3js" class="view-container">
        <iframe src="/3d-mesh" style="width: 100%; height: 100%; border: none;"></iframe>
    </div>

    <script>
        // ── UI TOGGLE LOGIC ──
        function switchView(viewName) {
            document.querySelectorAll('.toggle-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.view-container').forEach(vc => vc.classList.remove('active'));
            
            if (viewName === 'map') {
                document.querySelector('#ui-toggle button:nth-child(1)').classList.add('active');
                document.getElementById('view-map').classList.add('active');
            } else if (viewName === 'grid') {
                document.querySelector('#ui-toggle button:nth-child(2)').classList.add('active');
                document.getElementById('view-grid').classList.add('active');
            } else if (viewName === '3js') {
                document.querySelector('#ui-toggle button:nth-child(3)').classList.add('active');
                document.getElementById('view-3js').classList.add('active');
            }
        }

        function notify(msg, type='info') {
            const n = document.getElementById('notification');
            n.innerText = msg;
            n.style.display = 'block';
            n.style.background = type === 'error' ? 'var(--danger)' : 'rgba(0,255,255,0.9)';
            setTimeout(() => n.style.display = 'none', 5000);
        }
    </script>

    <!-- DEPLOYMENT MODAL -->
    <div id="deploy-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:10000; justify-content:center; align-items:center;">
        <div style="background:#001030; border:2px solid var(--accent); padding:30px; border-radius:10px; width:400px; box-shadow: 0 0 30px var(--accent);">
            <h2 style="color:var(--accent); margin-top:0;">🚀 Deploy Configuration</h2>
            
            <p style="font-size:14px; color:#aaa;">Select networks to join:</p>
            <div id="network-list" style="margin-bottom:20px; max-height:100px; overflow-y:auto; border:1px solid #333; padding:10px;">
                <!-- Dynamically filled -->
            </div>

            <p style="font-size:14px; color:#aaa;">Target Server:</p>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom:20px;">
                <label><input type="checkbox" name="srv" value="unit1"> Unit 1</label>
                <label><input type="checkbox" name="srv" value="unit2"> Unit 2</label>
                <label><input type="checkbox" name="srv" value="unit3"> Unit 3</label>
                <label><input type="checkbox" name="srv" value="unit4"> Unit 4</label>
                <label><input type="checkbox" name="srv" value="unit5"> Unit 5</label>
                <label><input type="checkbox" name="srv" value="unit6"> Unit 6</label>
                <label style="grid-column: span 2; color:var(--accent); font-weight:bold;">
                    <input type="checkbox" name="srv" value="efficient" checked> Most Efficient Option
                </label>
            </div>

            <div style="display:flex; justify-content:space-between;">
                <button onclick="closeDeployModal()" style="background:#444; color:white; border:none; padding:10px 20px; cursor:pointer;">Cancel</button>
                <button onclick="confirmDeployment()" style="background:var(--accent); color:black; border:none; padding:10px 20px; cursor:pointer; font-weight:bold;">Deploy</button>
            </div>
        </div>
    </div>

    <script>
        let selectedFolderPath = "";

        function openDeployModal(path) {
            selectedFolderPath = path;
            const netList = document.getElementById('network-list');
            netList.innerHTML = "Loading networks...";
            
            // Fetch available networks from backend
            fetch('/api/networks')
                .then(r => r.json())
                .then(networks => {
                    netList.innerHTML = "";
                    networks.forEach(net => {
                        netList.innerHTML += `<label style="display:block;"><input type="checkbox" class="net-check" value="${net}"> ${net}</label>`;
                    });
                });

            document.getElementById('deploy-modal').style.display = 'flex';
        }

        function closeDeployModal() {
            document.getElementById('deploy-modal').style.display = 'none';
        }

        function confirmDeployment() {
            const networks = Array.from(document.querySelectorAll('.net-check:checked')).map(cb => cb.value);
            const servers = Array.from(document.querySelectorAll('input[name="srv"]:checked')).map(cb => cb.value);
            
            notify("Deploying services... please wait.");
            
            fetch('/trigger-deploy-final', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    folder_path: selectedFolderPath,
                    networks: networks,
                    servers: servers
                })
            })
            .then(r => r.json())
            .then(data => {
                if (data.status === 'Success') {
                    notify("Deployment Successful!", "success");
                } else {
                    notify("Deployment Failed: " + (data.error || "Unknown error"), "error");
                }
                closeDeployModal();
                loadRegistryData();
            })
            .catch(err => notify("Critical Deployment Error: " + err, "error"));
        }

        document.getElementById('add-docker-btn').addEventListener('click', function() {
            const path = document.getElementById('manual-path').value;
            if (!path) {
                notify("Please enter a valid folder path.", "error");
                return;
            }
            openDeployModal(path);
        });


        // ── DATA FETCHING & RENDERING ──
        let network = null; // Vis network instance
        const ACCENT_COLOR = '#00f0ff';

        function timeSince(dateString) {
            if (!dateString) return "Unknown";
            const date = new Date(dateString);
            const seconds = Math.floor((new Date() - date) / 1000);
            if (seconds < 60) return "Just now";
            if (seconds < 3600) return Math.floor(seconds / 60) + "m ago";
            if (seconds < 86400) return Math.floor(seconds / 3600) + "h ago";
            return Math.floor(seconds / 86400) + "d ago";
        }

        function loadRegistryData() {
            fetch('/api/registry')
                .then(response => response.json())
                .then(data => {
                    renderGrid(data);
                    renderMap(data);
                })
                .catch(error => {
                    console.error("Failed to load registry data:", error);
                });
        }

        function renderGrid(registryData) {
            const tbodyDocker = document.getElementById('tbody-docker');
            const tbodyWebsites = document.getElementById('tbody-websites');
            const tbodyDevices = document.getElementById('tbody-devices');
            
            tbodyDocker.innerHTML = '';
            tbodyWebsites.innerHTML = '';
            tbodyDevices.innerHTML = '';
            
            const services = Object.values(registryData.services || {});
            const nodes = Object.entries(registryData.nodes || {}).map(([id, data]) => ({...data, id, category: 'devices'}));
            
            const dockerList = services.filter(s => s.category === 'docker containers');
            const websiteList = services.filter(s => s.category === 'websites');
            
            document.getElementById('count-devices').innerText = nodes.length;
            document.getElementById('count-docker').innerText = dockerList.length;
            document.getElementById('count-websites').innerText = websiteList.length;

            function createMetaBadges(metadata) {
                const cell = document.createElement('td');
                if (!metadata) return cell;
                Object.entries(metadata).forEach(([k, v]) => {
                    if (v && v !== 'nan' && v !== 'None' && k !== 'is_openvpn' && 
                        !['cpu_usage_percent', 'mem_percent', 'cpu_temp_c', 'disk_percent'].includes(k)) {
                        const badge = document.createElement('span');
                        badge.className = 'meta-badge';
                        badge.innerText = `${k}: ${v}`;
                        cell.appendChild(badge);
                    }
                });
                return cell;
            }

            function createStatsBadges(item) {
                const cell = document.createElement('td');
                if (item.name !== 'lokey-client' || !item.metadata) return cell;
                
                const meta = item.metadata;
                const stats = [];
                
                if (meta.cpu_usage_percent !== undefined) stats.push({l: 'CPU', v: meta.cpu_usage_percent + '%', c: '#00ff00'});
                if (meta.mem_percent !== undefined) stats.push({l: 'RAM', v: meta.mem_percent + '%', c: '#00f0ff'});
                if (meta.cpu_temp_c) stats.push({l: 'TEMP', v: meta.cpu_temp_c + '°C', c: '#ff8800'});
                if (meta.disk_percent !== undefined) stats.push({l: 'DISK', v: meta.disk_percent + '%', c: '#a200ff'});
                
                stats.forEach(s => {
                    const badge = document.createElement('span');
                    badge.className = 'node-badge';
                    badge.style.borderColor = s.c;
                    badge.style.color = s.c;
                    badge.style.marginRight = '4px';
                    badge.innerText = `${s.l}: ${s.v}`;
                    cell.appendChild(badge);
                });
                return cell;
            }

            // --- DEVICES TABLE ---
            nodes.forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="font-weight:bold">${item.name || item.id}</td>
                    <td>${item.ip || 'unknown'}</td>
                    <td>${item.type || '-'}</td>
                    <td>
                        <span class="status-dot ${item.status === 'ONLINE' ? 'online' : 'offline'}"></span>
                        ${item.status}
                    </td>
                `;
                tr.appendChild(createMetaBadges(item.metadata));
                tr.innerHTML += `<td style="font-size:12px;color:#888">${item.last_seen ? timeSince(item.last_seen) : 'Never'}</td>`;
                tbodyDevices.appendChild(tr);
            });

            // --- DOCKER TABLE ---
            dockerList.forEach(item => {
                const tr = document.createElement('tr');
                const hostList = item.hosts || [item.host || 'unknown'];
                const hostBadges = hostList.map(h => `<span class="node-badge">${h}</span>`).join('');
                
                tr.innerHTML = `
                    <td style="font-weight:bold">${item.name}</td>
                    <td>${hostBadges}</td>
                    <td>${item.port || '-'}</td>
                    <td>${item.internal || '-'}</td>
                    <td>${item.url ? `<a href="${item.url}" target="_blank">${item.url}</a>` : '-'}</td>
                `;
                
                // Stats Column
                tr.appendChild(createStatsBadges(item));
                
                tr.innerHTML += `
                    <td>
                        <span class="status-dot ${item.status === 'ONLINE' ? 'online' : 'offline'}"></span>
                        ${item.status}
                    </td>
                `;
                tr.appendChild(createMetaBadges(item.metadata));
                tr.innerHTML += `<td style="font-size:12px;color:#888">${item.last_heartbeat ? timeSince(item.last_heartbeat) : 'Never'}</td>`;
                tbodyDocker.appendChild(tr);
            });

            // --- WEBSITES TABLE ---
            websiteList.forEach(item => {
                const tr = document.createElement('tr');
                const hostList = item.hosts || [item.host || 'unknown'];
                const hostBadges = hostList.map(h => `<span class="node-badge">${h}</span>`).join('');

                tr.innerHTML = `
                    <td style="font-weight:bold">${item.name}</td>
                    <td>${hostBadges}</td>
                    <td><a href="${item.url}" target="_blank">${item.url}</a></td>
                    <td>
                        <span class="status-dot ${item.status === 'ONLINE' ? 'online' : 'offline'}"></span>
                        ${item.status}
                    </td>
                `;
                tr.appendChild(createMetaBadges(item.metadata));
                tr.innerHTML += `<td style="font-size:12px;color:#888">${item.last_heartbeat ? timeSince(item.last_heartbeat) : 'Never'}</td>`;
                tbodyWebsites.appendChild(tr);
            });
        }


        function renderMap(registryData) {
            const nodes = new vis.DataSet();
            const edges = new vis.DataSet();
            
            const nodeDict = registryData.nodes || {};
            const mainUnits = ['unit1', 'unit2', 'unit3', 'unit4', 'unit5', 'unit6'];
            const vpnNodes = [];
            
            // Build the main unit skeleton
            mainUnits.forEach((uName) => {
                const nodeData = nodeDict[uName] || { status: 'OFFLINE', ip: 'pending...' };
                const isOnline = nodeData.status === 'ONLINE';
                const isOpenVPN = nodeData.is_openvpn_only || uName === 'unit2' || uName === 'unit4';
                
                // Red for Unit 2 & 4, Blue for others
                const color = isOpenVPN ? '#ff003c' : (isOnline ? '#4169E1' : '#2a3b63'); 
                const glowColor = isOpenVPN ? '#ff003c' : (isOnline ? ACCENT_COLOR : '#4169E1');
                
                nodes.add({
                    id: 'node_' + uName,
                    label: uName.toUpperCase() + '\n(' + (nodeData.ip || 'unknown') + ')',
                    shape: 'hexagon',
                    color: { background: '#001', border: color },
                    font: { color: color, size: 14, face: 'Courier New' },
                    size: 35,
                    shadow: { enabled: true, color: glowColor, size: 25 },
                    customData: { type: 'Device', status: nodeData.status, ip: nodeData.ip }
                });

                if (isOpenVPN || nodeData.openvpn_ip) {
                    vpnNodes.push('node_' + uName);
                }
            });

            // STRUCTURAL OPENVPN MESH (Connect every VPN node to every other VPN node)
            for (let i = 0; i < vpnNodes.length; i++) {
                for (let j = i + 1; j < vpnNodes.length; j++) {
                    edges.add({
                        from: vpnNodes[i],
                        to: vpnNodes[j],
                        color: { color: '#440000', highlight: '#ff003c' },
                        width: 1,
                        dashes: [2, 10],
                        length: 400
                    });
                }
            }

            const serviceDict = registryData.services || {};
            const traefikNodeIds = [];
            
            // Find all Traefik instances
            for (const [srvId, srvData] of Object.entries(serviceDict)) {
                if (srvData.name.toLowerCase().includes('traefik')) {
                    traefikNodeIds.push('srv_' + srvId);
                }
            }

            for (const [srvId, srvData] of Object.entries(serviceDict)) {
                const isOnline = srvData.status === 'ONLINE';
                const isWebsite = srvData.category === 'websites';
                const lowerName = srvData.name.toLowerCase();
                
                let shape, color, size, shadowSize;
                if (isWebsite) {
                    shape = 'globe'; color = isOnline ? '#ffff00' : '#888800'; size = 25; shadowSize = 20;
                } else {
                    shape = 'box'; color = isOnline ? '#00ff00' : '#007700'; size = 18; shadowSize = 15;
                    if (lowerName.includes('traefik')) {
                        shape = 'diamond'; color = isOnline ? '#00f0ff' : '#007788'; size = 30; shadowSize = 30;
                    } else if (lowerName.includes('apache')) {
                        shape = 'triangle'; color = isOnline ? '#ff8800' : '#884400'; size = 22;
                    } else if (lowerName.includes('bind')) {
                        shape = 'star'; color = isOnline ? '#a200ff' : '#550088'; size = 22;
                    }
                }
                
                nodes.add({
                    id: 'srv_' + srvId,
                    label: srvData.name,
                    shape: shape,
                    color: { background: '#000', border: color },
                    font: { color: color, size: 12, face: 'Courier New', strokeWidth: 2, strokeColor: '#000' },
                    size: size,
                    shadow: { enabled: isOnline, color: color, size: shadowSize },
                    customData: { type: srvData.category, status: srvData.status, url: srvData.url || srvData.internal || 'none', last_seen: timeSince(srvData.last_heartbeat) }
                });
                
                // MULTI-POINT CONNECTIONS
                if (srvData.category === 'docker containers') {
                    const hostList = srvData.hosts || ['unit1'];
                    hostList.forEach(h => {
                        const target = 'node_' + h;
                        if (nodes.get(target)) {
                            edges.add({
                                from: target,
                                to: 'srv_' + srvId,
                                color: { color: isOnline ? '#00ff00' : '#220000', highlight: '#00ff00' },
                                width: 2,
                                length: 150
                            });
                        }
                    });

                    // Tie to Traefik instances on the SAME host
                    traefikNodeIds.forEach(tId => {
                        const traefikSrvId = tId.replace('srv_', '');
                        const traefikData = serviceDict[traefikSrvId];
                        if (traefikData) {
                            const traefikHosts = traefikData.hosts || [traefikData.host || 'unknown'];
                            const intersection = hostList.filter(h => traefikHosts.includes(h));
                            if (intersection.length > 0 && 'srv_' + srvId !== tId) {
                                edges.add({
                                    from: tId,
                                    to: 'srv_' + srvId,
                                    color: { color: isOnline ? ACCENT_COLOR : '#003344', highlight: ACCENT_COLOR },
                                    width: 1,
                                    length: 250,
                                    dashes: [2, 5]
                                });
                            }
                        }
                    });
                } else if (isWebsite) {
                    // Tie websites to all Traefiks
                    traefikNodeIds.forEach(tId => {
                        edges.add({
                            from: tId,
                            to: 'srv_' + srvId,
                            color: { color: '#ffff00', highlight: '#ffff00' },
                            width: 1,
                            length: 200,
                            dashes: [5, 10]
                        });
                    });
                }
            }

            // Initialize Network if it doesn't exist, otherwise update data
            if (!network) {
                const container = document.getElementById('mynetwork');
                const data = { nodes: nodes, edges: edges };
                const options = {
                    nodes: { borderWidth: 2, borderWidthSelected: 4 },
                    physics: {
                        solver: 'forceAtlas2Based',
                        forceAtlas2Based: {
                            gravitationalConstant: -100,
                            centralGravity: 0.01,
                            springLength: 100,
                            springConstant: 0.08
                        }
                    },
                    interaction: { hover: true, tooltipDelay: 200 }
                };
                network = new vis.Network(container, data, options);

                network.on("click", function (params) {
                    if (params.nodes.length > 0) {
                        const nodeId = params.nodes[0];
                        const node = nodes.get(nodeId);
                        if (nodeId === 'root') {
                            document.getElementById('info-panel').style.display = 'none';
                            return;
                        }
                        
                        const cData = node.customData;
                        document.getElementById('info-name').innerText = node.label.split('\n')[0];
                        document.getElementById('info-type').innerText = cData.type;
                        document.getElementById('info-status').innerText = cData.status;
                        document.getElementById('info-status').style.color = (cData.status === 'ONLINE') ? 'var(--success)' : 'var(--danger)';
                        
                        if (cData.type === 'Service') {
                            document.getElementById('row-url').style.display = 'block';
                            document.getElementById('row-lastseen').style.display = 'block';
                            document.getElementById('info-url').innerText = cData.url;
                            document.getElementById('info-url').href = cData.url.startsWith('http') ? cData.url : 'https://' + cData.url;
                            document.getElementById('info-lastseen').innerText = cData.last_seen;
                        } else {
                            document.getElementById('row-url').style.display = 'none';
                            document.getElementById('row-lastseen').style.display = 'none';
                        }
                        
                        document.getElementById('info-panel').style.display = 'block';
                    } else {
                        document.getElementById('info-panel').style.display = 'none';
                    }
                });
            } else {
                network.setData({ nodes: nodes, edges: edges });
            }
        }

        // Auto-refresh data every 10 seconds
        loadRegistryData();
        setInterval(loadRegistryData, 10000);

    </script>
</body>
</html>
